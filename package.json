{
  "name": "dsh-computer-use",
  "version": "0.3.3",
  "description": "Computer Use: desktop observation and background actions, isolated browser DOM/ref tools, policy-checked batch workflows",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "computer-use",
    "cua-driver",
    "harness-desktop",
    "autopilot"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "compatibility": {
      "node": ">=22.18.0",
      "dsh": ">=0.1.2-rc.1"
    },
    "permissions": {
      "summary": "通过cua-driver操作原生桌面，或通过Playwright创建独立临时Chrome控制网页；默认headless，不连接用户现有profile。36个工具包含技能加载、只读条件等待/断言与受宿主逐步权限检查的动态编排。桌面编号/坐标与网页ref均受会话/TTL约束，危险操作及具体文件上传走本次审批；下载受宿主文件策略限制，只创建新文件。浏览器截图由attachments保存。可选GLM视觉读取用户配置key并发HTTPS请求，不输出key。",
      "commands": [
        "cua-driver call (non-shell fixed argv)",
        "Playwright-managed isolated installed Chrome"
      ],
      "writePaths": [
        "Browser-managed temporary profiles",
        "Explicit browser_download directory, restricted by host sandboxPolicy (new files only)"
      ],
      "externalServices": "User-requested http/https pages in isolated Chrome; optional configured Z.AI GLM vision API",
      "failureBoundaries": "cua-driver 缺失 → 结构化错误含自救指引；危险操作或前台键盘/文本重试未获用户审批 → 明确拒绝原因且不执行重试；观测快照过期 → 拒绝执行并提示重新观测；GLM key 未配置或请求失败 → 视觉 fallback 返回明确错误，不影响 AX/native 路径；超时 → 超时错误",
      "lifecycleEvidence": "docs/store-evidence.md"
    }
  },
  "files": [
    "index.js",
    "lib/",
    "tools/",
    "cordis.patch.yml",
    "README.md",
    "VERIFICATION.md",
    "LICENSE",
    "PERMISSIONS.md",
    "docs/",
    "assets/",
    "verify-runtime.mjs",
    "verify-desktop.mjs",
    "verify-browser.mjs",
    "skills/",
    "chrome-extension/",
    "verify-agent.mjs",
    "verify-host.mjs",
    "verify-web.mjs",
    "verify-approval-ui.mjs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs",
    "doctor": "node tools/doctor.mjs",
    "verify:desktop": "node verify-desktop.mjs",
    "verify:browser": "node verify-browser.mjs",
    "verify:agent": "node verify-agent.mjs",
    "verify:host": "node verify-host.mjs",
    "verify:web": "node verify-web.mjs",
    "verify:approval-ui": "node verify-approval-ui.mjs",
    "browser:setup": "node tools/install-chrome-bridge.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.3",
    "@deepseek-ai/schemastery": ">=3.18.2 <4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/988hj7tczd-oss/dsh-computer-use.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "playwright-core": "1.61.1",
    "ws": "8.22.1"
  }
}
