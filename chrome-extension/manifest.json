{
  "manifest_version": 3,
  "name": "DSH Chrome Control",
  "version": "0.1.0",
  "description": "Visible, owner-scoped Chrome tab groups for DeepSeek Harness.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH Chrome 控制",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
